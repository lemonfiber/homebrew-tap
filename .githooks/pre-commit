#!/bin/sh
# The fast checks CI runs, before the commit rather than after the push.
#
# Fast only: `brew style` needs Homebrew and a formula load, which is a minute
# somebody would rather spend elsewhere, so it stays in `formula.yml`. A hook
# that takes a minute is a hook people turn off, and one that is off enforces
# nothing (OPS-R51, Q-R57).
#
# Each check is skipped where its tool is absent, so a contributor without it
# gets CI’s answer rather than a hook that cannot run.

set -eu

# Say what did not run, and why. A check skipped because its tool is absent and a
# check that found nothing are the same silence otherwise, and the second is what
# somebody reads the first as — so the hook reports a pass it did not earn.
say() {
	printf 'pre-commit: %s\n' "$1" >&2
}

ran=""

# `ruby -c` is the half of the formula check that costs nothing: the file brew
# executes has to parse, and a formula that does not is one nobody can install.
if command -v ruby >/dev/null 2>&1; then
	for formula in Formula/*.rb; do
		[ -e "$formula" ] || continue
		ruby -c "$formula" >/dev/null || exit 1
	done
	ran="${ran}every formula parses; "
else
	say "ruby is not installed, so no formula was parsed here. \`brew style\` and \`ruby -c\` both run in CI."
fi

if command -v typos >/dev/null 2>&1; then
	typos || exit 1
	ran="${ran}no typo; "
else
	say "typos is not installed, so nothing was spell-checked here. \`hygiene / typos\` runs in CI. Install it: brew install typos-cli"
fi

if [ -n "$ran" ]; then
	say "ran: ${ran%; }"
fi
exit 0
